{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API (FastAPI)",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Web (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run TalentMatch (API + Web)",
      "dependsOn": ["API (FastAPI)", "Web (Vite)"],
      "problemMatcher": []
    },
    {
      "label": "Backend tests",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m pytest",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
