# Copy to .env (never commit .env). All values below are placeholders for local development.

APP_ENV=development
DEMO_MODE=true

# Local demo default is SQLite under backend/data. For PostgreSQL (docker compose):
# DATABASE_URL=postgresql+psycopg://talentmatch:CHANGE_ME@localhost:5432/talentmatch
DATABASE_URL=

# Private document storage (outside any web root)
STORAGE_DIR=

# REQUIRED outside development: a long random secret, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=480

MAX_UPLOAD_MB=10
MAX_PDF_PAGES=40

# thread = in-process worker (local dev) | worker = run `python -m app.worker` separately | inline = tests
TASK_MODE=thread

# Only "mock" is implemented in milestone 1.
LLM_PROVIDER=mock
EMAIL_PROVIDER=mock
EMAIL_FROM=talentmatch-noreply@acme.example

# Base URL used for authenticated application links in shortlist emails
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Placeholders for future real integrations (NOT used yet; do not put real secrets in files) ---
# LLM_API_KEY=
# ATS_BASE_URL=
# ATS_CLIENT_ID=
# ATS_CLIENT_SECRET=
# Read-only IMAP recruitment mailbox (connector implemented, not yet tested against a real mailbox).
# Leave empty to keep it disabled. Only set with written authorization from the mailbox owner.
MAILBOX_IMAP_PASSWORD=
MAX_EMAIL_MB=30
# MAILBOX_TENANT_ID=
# MAILBOX_CLIENT_ID=
# MAILBOX_CLIENT_SECRET=
# EMAIL_PROVIDER_API_KEY=
